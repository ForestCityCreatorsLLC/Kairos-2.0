# KAIROS 2.0 — Environment Configuration Template
# Copy this file to .env and populate keys. Never commit .env to Git.

# 1. Single Source of Truth (Obsidian Vault Path) & Operator
KAIROS_VAULT_PATH="C:/Users/igxxg/OneDrive/Documents/FCC Business Docs/Canopy Vault"
KAIROS_OPERATOR_NAME="Jaime Flores"

# 2. Local AI Route (LM Studio — Gemma 4 12B KV-Pinned)
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
LMSTUDIO_MODEL="google/gemma-4-12b"

# 3. Cloud AI Route (Google Gemini API)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 3b. Full-Duplex Cognitive Voice Pipeline (Kokoro-82M + faster-whisper + Verbalizer)
KOKORO_VOICE="af_heart"
KOKORO_MODEL_PATH="models/kokoro-v1.0.onnx"
KOKORO_VOICES_PATH="models/voices-v1.0.bin"
WHISPER_MODEL_SIZE="large-v3-turbo"
LAG_THRESHOLD_SEC="0.50"
PREFILL_WATCHDOG_SEC="0.55"
THOUGHT_CADENCE_SEC="3.20"
CLOUD_TIMEOUT_SEC="3.0"
KAIROS_VRAM_CEILING_GB="11.86"

# 4. Optional Google Workspace & GitHub Connectors
GOOGLE_OAUTH_CREDENTIALS_PATH="credentials.json"
GOOGLE_OAUTH_TOKEN_PATH="token.json"
GITHUB_TOKEN=""
GitHub_Username=""
GitHub_Password=""

# 5. Service Ports
KAIROS_CORE_PORT=8420
KAIROS_VOICE_PORT=8421

# 6. Weather APIs (Tomorrow.io & OpenWeatherMap)
TOMORROW_IO_API_KEY=""
OWM_API_KEY=""
OWM_BASE_URL="https://api.openweathermap.org/data/2.5/weather"
KAIROS_DEFAULT_CITY="Cleveland,US"

# 7. Autoresponder (Sendiio)
SENDIIO_API_KEY=""
SENDIIO_API_SECRET=""

# 8. Mobile & Remote Relay Bridge Settings (Discord)
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
DISCORD_AUTHORIZED_USER_ID=""
DISCORD_WEBHOOK_URL=""

# 9. Hugging Face & Printful Merch APIs
HUGGINGFACE_API_KEY=""
PRINTFUL_API_KEY=""
